# Copy this file to .env and fill in your own keys. Never commit .env.

# Teacher and baseline model (free tier): https://console.groq.com/keys
GROQ_API_KEY=

# Optional overrides (defaults shown)
# TEACHER_MODEL=openai/gpt-oss-120b
# TEACHER_BASE_URL=https://api.groq.com/openai/v1
# TEACHER_REASONING_EFFORT=low

# Push datasets and models to the Hub: https://huggingface.co/settings/tokens
HF_TOKEN=
